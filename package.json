{
  "name": "bookser",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "imports": {
    "#bookser-reader": {
      "node": "./whatsapp/bookser-reader.node.mjs",
      "default": "./whatsapp/bookser-reader.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "seed": "tsx scripts/seed.ts",
    "export:postgres": "tsx scripts/export-from-postgres.ts",
    "deploy": "npm run build && firebase deploy",
    "test": "node test/alignment.test.mjs && node test/readingLevel.test.mjs && node test/coins.test.mjs && node test/sttEscalation.test.mjs && node test/sttIntegration.test.mjs && node test/parentGate.test.mjs && node test/photoAuthenticity.test.mjs && node test/tournament.test.mjs && node test/cards.test.mjs && node test/architecture.test.mjs && node audit.mjs && npm run test:whatsapp",
    "test:critic": "node test/architecture.test.mjs",
    "whatsapp:dev": "node whatsapp/server.mjs",
    "whatsapp:export": "node whatsapp/build-simulator.mjs",
    "test:whatsapp": "node --test test/whatsapp*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/pt-serif": "5.3.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@sparticuz/chromium": "^149.0.0",
    "fflate": "^0.8.3",
    "firebase": "^11.1.0",
    "lucide-react": "^1.25.0",
    "pdfjs-dist": "^4.8.69",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "firebase-admin": "^13.0.1",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
